<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly content loop for tovyphotography.com. Mondays at 9:00 local time.
  If the Mac is asleep at 9:00, launchd runs it at the next wake.
  This file is a template: __REPO__ and __HOME__ are filled in by scripts/install-launchd.sh,
  which writes ~/Library/LaunchAgents/com.tovy.weekly-page.plist and loads it.
  Load it on ONE machine only. To remove: scripts/install-launchd.sh --uninstall
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tovy.weekly-page</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/weekly-page.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/node/bin:__HOME__/.local/bin:__HOME__/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key>
      <integer>1</integer>
      <key>Hour</key>
      <integer>9</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>4</integer>
      <key>Hour</key>
      <integer>9</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/tovy-weekly-page.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/tovy-weekly-page.log</string>
</dict>
</plist>

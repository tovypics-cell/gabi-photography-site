<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly content loop for tovyphotography.com. Mondays at 9:00 local time.
  If the Mac is asleep at 9:00, launchd runs it at the next wake.
  Installed copy lives at ~/Library/LaunchAgents/com.tovy.weekly-page.plist.
  Reload after editing:
    launchctl bootout gui/$(id -u)/com.tovy.weekly-page
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.tovy.weekly-page.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tovy.weekly-page</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/gabiamrami/gabi-photography-site/scripts/weekly-page.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/gabiamrami/gabi-photography-site</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/gabiamrami/.local/node/bin:/Users/gabiamrami/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/gabiamrami</string>
  </dict>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key>
      <integer>1</integer>
      <key>Hour</key>
      <integer>9</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>4</integer>
      <key>Hour</key>
      <integer>9</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/gabiamrami/Library/Logs/tovy-weekly-page.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/gabiamrami/Library/Logs/tovy-weekly-page.log</string>
</dict>
</plist>
